# Discord bot token from the Developer Portal. Never commit the real value.
TOKEN=replace_with_your_discord_bot_token

# Lavalink node. Playback, provider URLs, and YouTube search are handled here.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
LAVALINK_SECURE=false

# Optional Lavalink reconnect/resume settings.
LAVALINK_RESUME=true
LAVALINK_RESUME_TIMEOUT=60
LAVALINK_RECONNECT_TRIES=5
LAVALINK_RECONNECT_DELAY=5000
