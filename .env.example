# Discord bot token from the Developer Portal. Never commit the real value.
TOKEN=replace_with_your_discord_bot_token

# NodeLink v3 connection used by the bot. In Docker Compose, host/port/TLS/API
# are set to the internal nodelink service automatically.
NODELINK_HOST=localhost
NODELINK_PORT=2333
NODELINK_PASSWORD=replace_with_a_long_random_password
NODELINK_TLS=false
NODELINK_API_VERSION=4

# Text search source. NodeLink supports ytmsearch, ytsearch, spsearch and search.
NODELINK_SEARCH_SOURCE=ytmsearch

# Session resume and reconnect behavior for the Lavalink v4 WebSocket client.
NODELINK_RESUME=true
NODELINK_RESUME_TIMEOUT=60
NODELINK_RECONNECT_TRIES=5
NODELINK_RECONNECT_DELAY=5000

# Docker-only NodeLink options. The API is exposed on 127.0.0.1 by default.
NODELINK_EXPOSE_PORT=2333
NODELINK_LOGGING_LEVEL=info
NODELINK_SPONSORBLOCK_ENABLED=false
